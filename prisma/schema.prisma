generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Theme {
  id        String   @id @default(cuid())
  number    Int
  title     String
  emoji     String
  color     String
  identity  String   @default("")
  createdAt DateTime @default(now())

  goals Goal[]
}

model Goal {
  id           String    @id @default(cuid())
  themeId      String
  theme        Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  title        String
  notes        String    @default("")
  deadline     DateTime?
  completed    Boolean   @default(false)
  completedAt  DateTime?
  currentValue Float?    // e.g. 340000
  targetValue  Float?    // e.g. 500000
  unit         String?   // e.g. "$", "VO2", "sessions"
  createdAt    DateTime  @default(now())

  systems   System[]
  dailyLogs DailyLog[]
}

model System {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  description String
  frequency   String    // "daily" | "weekly" | "as_needed" | "one_time"
  deadline    DateTime?
  targetCount Int       @default(1) // how many times per period to complete

  completions SystemCompletion[]
}

model DailyLog {
  id     String @id @default(cuid())
  date   String // YYYY-MM-DD
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  notes  String @default("")

  systemCompletions SystemCompletion[]

  @@unique([goalId, date])
}

model SystemCompletion {
  id         String  @id @default(cuid())
  completed  Boolean @default(false)
  count      Int     @default(0) // for multi-count systems: how many done this day
  systemId   String
  system     System  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  dailyLogId String
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@unique([systemId, dailyLogId])
}
